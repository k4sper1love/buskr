ENV=local
TIMEZONE=Asia/Almaty

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_DEFAULT_LANG=ru
TELEGRAM_ADMIN_LANG=ru
TELEGRAM_ADMIN_CHAT_ID=-1234567890
TELEGRAM_ADMIN_THREAD_APPLICATIONS=0
TELEGRAM_ADMIN_THREAD_UPGRADES=0
TELEGRAM_PUBLIC_CHAT_ID=0
TELEGRAM_SUPPORT_CONTACT=@buskr_support
INVITE_TTL_HOURS=24

DATABASE_DSN=postgres://buskr:buskr@localhost:5432/buskr?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s

MAP_WEB_APP_URL=https://yourdomain.com/map.html

# Booking
BOOKING_MAX_ACTIVE=2
BOOKING_MAX_PER_LOCATION_AT_DAY=1
BOOKING_MAX_ADVANCE_DAYS=5
BOOKING_ADJACENCY_RADIUS=100
BOOKING_ENABLE_HOT_SLOTS=true
BOOKING_ENABLE_NO_SHOW_CANCEL=true
BOOKING_MIN_HOUR=10
BOOKING_MAX_HOUR_WEEKDAY=22
BOOKING_MAX_HOUR_WEEKEND=23
BOOKING_MAX_DURATION_HOURS=3

# Admin booking overrides (-1 = no limit)
BOOKING_ADMIN_MAX_ACTIVE=-1
BOOKING_ADMIN_MAX_PER_LOCATION_AT_DAY=-1
BOOKING_ADMIN_MAX_DURATION_HOURS=-1
BOOKING_ADMIN_BYPASS_NOISE_LIMITS=true
BOOKING_ADMIN_BYPASS_USER_OVERLAP=true
BOOKING_ADMIN_BYPASS_NOISY_NEIGHBOR=true

# Karma
KARMA_MAX=100
KARMA_MIN=0
KARMA_REWARD=5
KARMA_PENALTY=20
KARMA_PERFECT_THRESHOLD=100
KARMA_WARNING_THRESHOLD=50
